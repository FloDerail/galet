<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.FloDerail.Galet</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Galet</name>
  <summary>Finder-inspired file manager with colour tags</summary>
  <summary xml:lang="fr">Gestionnaire de fichiers inspiré du Finder, avec tags de couleur</summary>
  <developer id="io.github.floderail">
    <name>Florian Dérail</name>
  </developer>
  <description>
    <p>
      Galet brings the best of the macOS Finder to Linux, as a native GNOME application.
      Its author never found a file manager that suited him, so he built his own.
    </p>
    <p xml:lang="fr">
      Galet apporte le meilleur du Finder de macOS à Linux, en application GNOME native.
      Son auteur n’a jamais trouvé d’explorateur qui lui convienne : il a créé le sien.
    </p>
    <ul>
      <li>Colour tags on files and folders, with a sidebar section per tag</li>
      <li>Icon, list, column and gallery views, tabs, Quick Look and preview pane</li>
      <li>Search in sub-folders and inside documents, smart folders</li>
      <li>Quick actions: rotate, convert, resize, create PDF, compress, extract</li>
      <li>Network servers (SMB, SFTP, FTP, WebDAV), send to phone</li>
      <li>Themes: System, macOS, Windows 11 or your own</li>
      <li>Optional AI (local Ollama by default, or Claude, Mistral, Gemini, ChatGPT): plain-language search and tag suggestions</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.FloDerail.Galet.desktop</launchable>
  <provides>
    <binary>galet</binary>
  </provides>
