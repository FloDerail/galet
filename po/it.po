msgstr "{n} commit"

msgid "{n} commits"
msgstr "{n} commit"

msgid "Mark as Deployed"
msgstr "Segna come distribuito"

msgid "Some files could not be deployed: {error}"
msgstr "Impossibile distribuire alcuni file: {error}"

