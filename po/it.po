msgstr "Apri il progetto da un lato e la cartella del server dall'altro."

msgid "Deploy the Pushed Commits (Git)…"
msgstr "Distribuisci i commit inviati (Git)…"

msgid "Deploy…"
msgstr "Distribuisci…"

msgid "Deploy the pushed commits (Git)…"
msgstr "Distribuisci i commit inviati (Git)…"

msgid "Open your Git project on one side and the server folder on the other."
msgstr "Apri il progetto Git da un lato e la cartella del server dall'altro."

msgid "{n} commit pushed since the last deployment to “{server}”"
msgstr "{n} commit inviato dall'ultima distribuzione verso «{server}»"

