msgstr "{project} → {server}"

msgid "Looking for the commits to deploy…"
msgstr "Ricerca dei commit da distribuire…"

msgid "First deployment: the files tracked by Git ({ref}, {sha}) are compared with the server (size and date). Next time, only the files changed by your new commits will be sent."
msgstr "Prima distribuzione: i file tracciati da Git ({ref}, {sha}) vengono confrontati con il server (dimensione e data). Le volte successive verranno inviati solo i file modificati dai nuovi commit."

msgid "Nothing to deploy: the server already has {ref} ({sha})."
msgstr "Niente da distribuire: il server ha già {ref} ({sha})."

msgid "{n} commit pushed since the last deployment ({base} → {sha}, {ref})."
msgstr "{n} commit inviato dall'ultima distribuzione ({base} → {sha}, {ref})."

msgid "{n} commits pushed since the last deployment ({base} → {sha}, {ref})."
msgstr "{n} commit inviati dall'ultima distribuzione ({base} → {sha}, {ref})."

msgid "This branch has no upstream on GitHub: the local branch “{branch}” is used."
msgstr "Questo branch non ha un upstream su GitHub: viene usato il branch locale «{branch}»."

